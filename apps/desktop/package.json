{
  "name": "@condeck/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ConDeck Desktop — host application (Electron + React).",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "pnpm build:electron && pnpm build:renderer",
    "build:electron": "vite build --config vite.electron.main.config.ts && vite build --config vite.electron.preload.config.ts",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@condeck/action-engine": "workspace:*",
    "@condeck/database": "workspace:*",
    "@condeck/obs-integration": "workspace:*",
    "@condeck/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
