{
  "name": "condeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ConDeck — virtual Stream Deck for OBS Studio. Desktop host + mobile remote.",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @condeck/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @condeck/database db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
